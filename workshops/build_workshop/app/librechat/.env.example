# LibreChat add-on for workshop module 06b. Copy to .env and fill in.
#   cp .env.example .env

# --- Host port for the LibreChat UI ---
LIBRECHAT_PORT=3090

# --- Default seeded user (log in with these; no signup) ---
LIBRECHAT_DEFAULT_EMAIL=workshop@example.com
LIBRECHAT_DEFAULT_PASSWORD=clickhouse
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true

# --- Agent LLM: reuse your workshop OpenAI key (from ../.env.workshop) ---
OPENAI_API_KEY=

# --- ClickStack MCP: your ClickHouse Cloud service UUID (Console > service > Settings) ---
CLICKSTACK_SERVICE_ID=

# --- GitHub MCP: your fine-grained, READ-ONLY PAT on ClickHouse/ClickHouse_Demos ---
GITHUB_PAT=

# --- LibreChat secrets (safe demo defaults; regenerate for anything non-workshop) ---
JWT_SECRET=16f8c0ef4a5d391b26034086c628469d3f9f497f08163ab9b40137092f2909ef
JWT_REFRESH_SECRET=eaa5191f2914e30b9387fd84e254e4ba6fc51b4654968a9b0803b456a54b8418
CREDS_KEY=f34be427ebb29de8d88c107a71546019685ed8b241d8f2ed00c3df97ad2566f0
