# ---------------------------------------------------------------------------
# Workshop environment for docker-compose.workshop.yml
#
#   cp .env.workshop.example .env.workshop
#   # fill in the values below, then:
#   docker compose --env-file .env.workshop -f docker-compose.workshop.yml up -d
# ---------------------------------------------------------------------------

# === ClickHouse Cloud (REQUIRED) ===========================================
# From the ClickHouse Cloud console: your service endpoint hostname and the
# password for the SQL user you are connecting as.
#
# CLICKHOUSE_HOST is the bare hostname, no scheme and no port, e.g.
#   abc123xyz.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=nyc_tlc_data
# TLS is required for ClickHouse Cloud. Leave this true for the workshop.
CLICKHOUSE_SECURE=true
# ClickHouse Cloud can idle-scale to zero; give the first connection headroom.
CLICKHOUSE_CONNECT_TIMEOUT=10

# === Postgres (loadgen source) =============================================
# The loadgen (pg-trip-writer) writes synthetic trips here; a Postgres CDC
# ClickPipe then captures them into ClickHouse Cloud.
#
# PRIMARY PATH: your OWN Postgres managed by ClickHouse, created in module 03
# with `clickhousectl cloud postgres create`. Paste the hostname and the
# one-time password from that command's JSON output below. The connection user
# is the instance admin, so the loadgen creates the table and publication for
# you (no psql needed), and the instance ships with wal_level=logical + 10
# replication slots, so CDC works out of the box.
PGHOST=<your managed-postgres hostname from clickhousectl>
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=<one-time password printed by clickhousectl cloud postgres create>
# Managed Postgres mandates TLS (honored natively by psycopg3/libpq). Keep 'require'.
PGSSLMODE=require
# Publication the ClickPipe subscribes to; the loadgen creates it on your
# instance. Keep as-is unless a hand-out slip tells you otherwise.
PG_PUBLICATION=pub_taxi
#
# LOCAL CONTAINER FALLBACK (offline dev, no managed instance): use the bundled
# `postgres` service instead - set PGHOST=postgres, PGDATABASE=taxi, PGUSER=taxi,
# PGPASSWORD=taxi, PGSSLMODE=prefer (matches the container credentials below).
# INSTRUCTOR-SHARED FALLBACK (only if managed Postgres is unavailable in your
# org): fill all PG* values from the hand-out slip your instructor provides.

# Throttle for the loadgen. On your own managed instance a low rate just keeps
# the demo readable; on the shared fallback it matters (30+ generators feed one
# instance). Effective rows/sec ~= RATE_PER_SEC.
RATE_PER_SEC=2
BATCH_SIZE=10

# === Local fallback Postgres container credentials =========================
# Only used by the bundled `postgres` service (when PGHOST=postgres). Keep in
# sync with the PG* values above if you rely on the local container fallback.
POSTGRES_DB=taxi
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi

# === AI chat + Langfuse (Module 07) ========================================
# Your own OpenAI API key powers the in-app chat (NL-to-SQL). The app runs
# without it; the chat panel returns a setup hint until it is set.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=https://api.openai.com/v1
# Langfuse Cloud project keys (Project Settings -> API Keys). Optional; chat
# works untraced without them. LANGFUSE_BASE_URL is the v4 SDK name.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# === ClickStack observability (Modules 05-06, docker-compose.otel.yml) =====
# Shared secret securing the local collector's OTLP endpoints; the backend
# sends it back as the `authorization` header. Any hard-to-guess string.
OTLP_AUTH_TOKEN=change-me-workshop-token
# Database ClickStack uses for its otel_* tables inside your Cloud service
# (separate from the app data in CLICKHOUSE_DATABASE).
CLICKSTACK_DATABASE=otel
# Service name shown in HyperDX for the backend's traces/logs.
OTEL_SERVICE_NAME=nyc-taxi-backend
# Service name shown in HyperDX for the frontend's browser telemetry (errors,
# console, network, session replay). The browser SDK is baked in only when the
# otel overlay builds the frontend image (docker compose ... up -d --build).
OTEL_FRONTEND_SERVICE_NAME=nyc-taxi-frontend
# Backend + loadgen log verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Host ports for the collector's OTLP receivers; change only on conflicts.
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318

# === Module 06b — LibreChat agentic SRE (OPTIONAL) =========================
# Only needed for the optional module 06b add-on (app/librechat/), which reads
# THIS file. OPENAI_API_KEY above is reused for the agent's LLM.
# LibreChat UI port; change only on a conflict.
LIBRECHAT_PORT=3090
# Pre-seeded LibreChat login (no signup). Change if you like.
LIBRECHAT_DEFAULT_EMAIL=workshop@example.com
LIBRECHAT_DEFAULT_PASSWORD=clickhouse
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
# ClickStack MCP: your ClickStack Service ID (HyperDX > Team Settings > Data >
# Connections > Default > Service ID -- a UUID).
CLICKSTACK_SERVICE_ID=
# GitHub MCP: your fine-grained, READ-ONLY PAT on ClickHouse/ClickHouse_Demos.
GITHUB_PAT=
# LibreChat secrets (demo defaults; fine for the workshop).
JWT_SECRET=16f8c0ef4a5d391b26034086c628469d3f9f497f08163ab9b40137092f2909ef
JWT_REFRESH_SECRET=eaa5191f2914e30b9387fd84e254e4ba6fc51b4654968a9b0803b456a54b8418
CREDS_KEY=f34be427ebb29de8d88c107a71546019685ed8b241d8f2ed00c3df97ad2566f0
CREDS_IV=e2341419ec3dd3d19b13a1a87fafcbfb

# === Host port mappings (change only on conflicts) =========================
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
PGADMIN_HOST_PORT=5050

# === Backend query safety limits (rarely changed) ==========================
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
QUERY_TIMEOUT_SECONDS=5
MAX_ROWS_TO_READ=200000000
MAX_BYTES_TO_READ=5000000000

# === pgadmin (only with `--profile tools`) =================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
