%%{init: {'theme':'dark','themeVariables':{'primaryColor':'#1565C0','primaryTextColor':'#FFFFFF','primaryBorderColor':'#42A5F5','secondaryColor':'#00897B','tertiaryColor':'#222233','lineColor':'#90CAF9','textColor':'#E0E0E0','mainBkg':'#1E1E2E','nodeBorder':'#42A5F5','clusterBkg':'#1A1A2E','clusterBorder':'#5C6BC0','titleColor':'#FFFFFF','edgeLabelBackground':'#1E1E2E'}}}%%
flowchart TB
 subgraph SOURCES["SHARED DATA"]
  S3["S3 Parquet<br/>100M historical lines"]:::external
 end
 subgraph LOCAL["LEARNER LAPTOP"]
  GEN["Synthetic sales writer<br/>Batched transactions"]:::executor
  UI["Pricing workbench<br/>Learner approves"]:::accent
  OTEL["OpenTelemetry collector"]:::integration
 end
 subgraph CLOUD["LEARNER CLOUD ENVIRONMENT"]
  PG["Managed Postgres<br/>Operational state"]:::storage
  PIPE["ClickPipes<br/>Operational CDC"]:::integration
  CH["ClickHouse<br/>Sales and aggregate states"]:::storage
  SQL["SQL analytics<br/>Discover and compare"]:::query
  AGENT["ClickHouse Agents<br/>Retail Pricing Strategist"]:::executor
  STACK["ClickStack<br/>Receipt logs and traces"]:::query
 end
 S3 ==>|"Server-side load"| CH
 GEN ==>|"Direct sales batches"| CH
 GEN -->|"Inventory and batch metadata"| PG
 UI -->|"Approved price and receipt"| PG
 PG --> PIPE --> CH
 CH --> SQL
 SQL -->|"Evidence and scenarios"| UI
 SQL -->|"Read-only analysis"| AGENT
 AGENT -.->|"Recommendation to learner"| UI
 UI -.->|"Logs and traces"| OTEL
 OTEL -->|"Write telemetry tables"| CH
 CH --> STACK
 classDef query fill:#C2185B,color:#FFF,stroke:#E91E63,stroke-width:2px
 classDef executor fill:#00897B,color:#FFF,stroke:#26A69A,stroke-width:2px
 classDef storage fill:#0D47A1,color:#FFF,stroke:#1976D2,stroke-width:2px
 classDef integration fill:#00695C,color:#FFF,stroke:#00897B,stroke-width:2px
 classDef external fill:#37474F,color:#FFF,stroke:#546E7A,stroke-width:2px
 classDef accent fill:#F5FF50,color:#111,stroke:#C6CC41,stroke-width:2px
