# Copy to app/.env.workshop. Keep this file private after adding credentials.
# Setup generates and saves the installation ID and Cloud connection settings.
PRICING_SCENARIO_ID=grocery
PRICING_POSTGRES_ADMIN_DSN=
PRICING_POSTGRES_DSN=
PRICING_CLICKHOUSE_HOST=
PRICING_CLICKHOUSE_PORT=8443
PRICING_CLICKHOUSE_SECURE=true
PRICING_CLICKHOUSE_DATABASE=pricing
PRICING_CLICKHOUSE_USERNAME=default
PRICING_CLICKHOUSE_PASSWORD=
PRICING_SESSION_SECRET=
PRICING_ALLOWED_ORIGIN=http://localhost:8080
PRICING_DATASET_MANIFEST=
FRONTEND_HOST_PORT=8080
# Prepared workshop model.
PRICING_MODEL_PATH=pricing/artifacts/prepared/model.json

# Diagnostics: the local collector writes to the ClickHouse service above.
PRICING_OTEL_ENDPOINT=
PRICING_CLICKSTACK_DATABASE=otel
PRICING_CLICKSTACK_TRACE_TABLE=otel_traces
PRICING_DIAGNOSTICS_AGENT_MODE=replay
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_API_KEY=

# Setup detects your Cloud organization and public IPv4 address.
PRICING_REGION=ap-southeast-1
PRICING_POSTGRES_SIZE=c6gd.large
