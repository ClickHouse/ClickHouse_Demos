# =============================================================================
# Copy to .env and fill in. .env is gitignored. Never commit real credentials.
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a && source .env && set +a
#
# =============================================================================

# -----------------------------------------------------------------------------
# ClickHouse Cloud target
# -----------------------------------------------------------------------------
# From the Cloud console: pick your service, click "Connect".
# Use the NATIVE protocol port (9440) with secure=true for Atlas.
CH_CLOUD_HOST=abc123xyz.us-east-1.aws.clickhouse.cloud
CH_CLOUD_USER=default
CH_CLOUD_PASSWORD=replace_me
CH_CLOUD_DB=adtech

# Native protocol, TLS. This is what Atlas connects with.
# secure=true is mandatory on ClickHouse Cloud.
# Percent-encode a password containing / ? # or @, or the URL will not parse.
CH_CLOUD_URL=clickhouse://${CH_CLOUD_USER}:${CH_CLOUD_PASSWORD}@${CH_CLOUD_HOST}:9440/${CH_CLOUD_DB}?secure=true

# HTTPS endpoint, used by the helper scripts (seed, drift injection, verify)
# so you do not need clickhouse-client installed to run the demo.
CH_CLOUD_HTTP=https://${CH_CLOUD_HOST}:8443

# -----------------------------------------------------------------------------
# Local ClickHouse OSS target  (rehearsal — break it freely)
# -----------------------------------------------------------------------------
#   ./scripts/local-up.sh              (macOS / Linux / Git Bash / WSL)
#   .\scripts\win\local-up.ps1         (Windows PowerShell)
#
# Those drive docker-compose.yml, which publishes 9000 and 8123 on the same
# numbers and fixes the password, so the two values below already match and you
# normally edit nothing here. `docker compose up -d` directly is equivalent.
#
# NOT `atlas tool docker`: that publishes only the native port, on a random host
# port, with a generated password. Right for Atlas's own dev database
# (CH_DEV_URL), useless for a target the helper scripts drive over HTTP.
CH_LOCAL_URL=clickhouse://default:localpass@localhost:9000/adtech
CH_LOCAL_HTTP=http://localhost:8123

# Host ports for the local rehearsal container. Change these if 9000 or 8123 are
# already taken, and update the two URLs above to match.
LOCAL_CH_NATIVE_PORT=9000
LOCAL_CH_HTTP_PORT=8123

# Version and container name used by local-up / local-down.
LOCAL_CH_VERSION=26.6
LOCAL_CH_NAME=atlas-demo-ch

# -----------------------------------------------------------------------------
# Dev database  (scratch — Atlas wipes it on every command)
# -----------------------------------------------------------------------------
# Option B in SETUP.md step 6, and the default here: a throwaway container
#   managed by Atlas. Needs Docker.
#   Pin the version as close to your Cloud version as you can. Run
#   preflight to see the gap between this and your Cloud service.
#   Works identically on macOS and Windows — Atlas drives Docker either way.
CH_DEV_URL=docker://clickhouse/26.6/dev

# Option A in SETUP.md step 6, recommended for real use: a second ClickHouse
#   Cloud service. Exact engine and version parity with production. Idles when
#   not in use. Run CREATE DATABASE atlas_dev; on it first - Atlas does not
#   create the dev database, only the objects inside it.
# CH_DEV_URL=clickhouse://default:replace_me@dev123.us-east-1.aws.clickhouse.cloud:9440/atlas_dev?secure=true

# -----------------------------------------------------------------------------
# Demo knobs
# -----------------------------------------------------------------------------
# Rows to seed into ad_events. 5M is enough to make a table rebuild visibly
# non-instant without making anyone wait through a coffee break.
SEED_ROWS=5000000
