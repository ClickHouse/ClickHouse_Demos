# Real credentials. Never commit.
.env
.env.local

# Atlas working files
*.log
atlas.out

# Generated migrations. Created by `atlas migrate diff`, cleared by reset.sh.
# The repo ships with an empty migrations/ on purpose: SETUP.md step 9 has you
# generate the baseline yourself, which is the point of that step.
migrations/*.sql
migrations/atlas.sum

# Generated by scripts/gen-hcl.sh, removed by reset.sh
schema/hcl/schema.generated.hcl
schema/sql/schema.inspected.sql

# Local inspect dumps used during the demo
inspected.*
/tmp-*
